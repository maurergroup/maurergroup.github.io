---
interface Props {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  volume?: string;
  pages?: string;
  article?: string;
  doi?: string;
  pdf?: string;
  code?: string;
  dataset?: string;
  demo?: string;
}

const { title, authors, venue, year, volume, pages, article, doi, pdf, code, dataset, demo } = Astro.props;

// Build the citation string
let citation = venue;
if (volume) {
  citation += ` ${volume}`;
}
if (article) {
  citation += `, ${article}`;
} else if (pages) {
  citation += `, ${pages}`;
}
citation += ` (${year})`;
if (doi) {
  citation += `. DOI: ${doi}`;
}
---

<div class="publication">
  <div class="publication-title">{title}</div>
  <div class="publication-authors">{authors.join(', ')}</div>
  <div class="publication-venue">{citation}</div>
  <div class="publication-links">
    {pdf && <a href={pdf} class="pub-link" target="_blank">PDF</a>}
    {code && <a href={code} class="pub-link" target="_blank">Code</a>}
    {dataset && <a href={dataset} class="pub-link" target="_blank">Dataset</a>}
    {demo && <a href={demo} class="pub-link" target="_blank">Demo</a>}
  </div>
</div>

<style>
  .publication {
    background: var(--bg-alt);
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid var(--primary);
    margin-bottom: 1.5rem;
  }

  .publication-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .publication-authors {
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .publication-venue {
    font-style: italic;
    color: var(--text-light);
    margin-bottom: 0.75rem;
  }

  .publication-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pub-link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border: 1px solid var(--primary);
    border-radius: 4px;
    transition: all 0.3s;
    font-size: 0.875rem;
  }

  .pub-link:hover {
    background: var(--primary);
    color: white;
    text-decoration: none;
  }
</style>