---
interface Props {
  title: string;
  description: string;
  slug: string;
}

const { title, description, slug } = Astro.props;
---

<a href={`/research/${slug}`} class="research-card">
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="read-more">
    Learn more →
  </div>
</a>

<style>
  .research-card {
    background: var(--bg-alt);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
  }

  .research-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .research-card h3 {
    color: var(--primary);
    margin-bottom: 1rem;
    font-size: 1.5rem;
    transition: color 0.3s;
  }

  .research-card:hover h3 {
    color: var(--primary-dark);
  }

  .research-card p {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .read-more {
    color: var(--primary);
    font-weight: 500;
    font-size: 0.9rem;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .research-card:hover .read-more {
    opacity: 1;
  }
</style>