---
interface Props {
  name: string;
  role: string;
  email: string;
  image?: string;
  slug: string;
}

const { name, role, email, image, slug } = Astro.props;
const initials = name.split(' ').map(n => n[0]).join('');
---

<div class="team-member">
  <a href={`/team/${slug}`} class="member-link">
    <div class="member-photo">
      {image ? <img src={image} alt={name} /> : initials}
    </div>
    <div class="member-name">{name}</div>
  </a>
  <div class="member-role">{role}</div>
  <a href={`mailto:${email}`} class="member-email">{email}</a>
</div>

<style>
  .team-member {
    text-align: center;
  }

  .member-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .member-photo {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 3rem;
    font-weight: 600;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .member-link:hover .member-photo {
    transform: scale(1.05);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
  }

  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-name {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    transition: color 0.3s;
  }

  .member-link:hover .member-name {
    color: var(--primary);
  }

  .member-role {
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .member-email {
    color: var(--primary);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .member-email:hover {
    text-decoration: underline;
  }
</style>