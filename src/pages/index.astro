---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import TeamMember from '../components/TeamMember.astro';
import Publication from '../components/Publication.astro';
import ResearchCard from '../components/ResearchCard.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import OpportunityCard from '../components/OpportunityCard.astro';
import { getCollection } from 'astro:content';

const teamMembers = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const researchAreas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const software = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order);
const opportunities = (await getCollection('opportunities')).filter(opp => opp.data.open).sort((a, b) => a.data.order - b.data.order);

const principalInvestigator = teamMembers[0];

// Group team members by location (members can appear in multiple locations)
const locations = {
  at: teamMembers.filter(m => m.data.locations?.includes('at')),
  uk: teamMembers.filter(m => m.data.locations?.includes('uk')),
  de: teamMembers.filter(m => m.data.locations?.includes('de'))
};
---

<Layout title="Computational Surface Science"></Layout>
  <Navigation />
  <Hero 
    title="The Maurer Computational Surface Science Group"
    subtitle="Exploring the intersection of computational simulation and surface science to drive innovation in materials and chemical processes."
  />

  <div class="container">
    <section id="about">
      <h2>Machine-learning-enabled Chemical Dynamics at Interfaces</h2>
      <div class="research-overview">
       <p><b>Our Research Vision</b> is to develop and apply new simulation methods and prediction tools that fuse machine learning (ML) and data-driven approaches with quantum mechanical (QM) electronic structure and dynamical simulation methods. Doing so will remove existing bottlenecks in simulation capabilities that limit the length and time scales and the complexity of chemical simulations. More importantly, hybrid ML/QM methods enable fundamentally new prediction approaches that defy the conventional structure-to-property paradigm that underpins modern chemical studies. The Maurer group applies newly developed ML-enabled research tools in the areas of high-throughput molecular design for organic electronics and functional interfaces, as well as the study of chemical dynamics triggered by extremely short or intense light and electromagnetic fields.</p>
      </div>
      <h3 class="section-subheading">Head of the Group</h3>
      <div class="about-content">
        <div class="profile-image">
          {principalInvestigator.data.image ? (
            <img src={principalInvestigator.data.image} alt={principalInvestigator.data.name} />
          ) : (
            principalInvestigator.data.name.split(' ').map(n => n[0]).join('')
          )}
        </div>
        <div class="bio">
          <h3>{principalInvestigator.data.name}</h3>
          <p><strong>{principalInvestigator.data.role}</strong></p>
          <div class="bio-text">
            <p>
              Prof. Dr. Reinhard J. Maurer leads the Computational Surface Science Group, focusing on theoretical and computational methods to understand the chemistry and physics of surfaces and interfaces. He is Alexander-von-Humboldt Professor of Theoretical Chemistry at the University of Göttingen (Germany), Professor of Computational Materials Discovery at the University of Vienna (Austria), and a Max Planck Fellow at the Max Planck Institute for Multidisciplinary Sciences.
            </p>
            <p>
              His research combines electronic structure theory, molecular and quantum dynamics, and machine learning methods to study quantum phenomena at surfaces with applications in photocatalysis, nanotechnology, and electrochemistry.
            </p>
            <p><a href="/team/reinhard-maurer">Read full profile →</a></p>
          </div>
        </div>
      </div>
    </section>

    <section id="research">
      <h2>Research Areas</h2>
      <p class="section-subtitle">Our lab focuses on several cutting-edge areas of computational material science and chemistry</p>
      <div class="research-grid">
        {researchAreas.map(area => (
          <ResearchCard
            title={area.data.title}
            description={area.data.description}
            slug={area.slug}
          />
        ))}
      </div>
    </section>

    <section id="team">
      <h2>Our Team</h2>
      <p class="section-subtitle">Meet the brilliant minds behind our research</p>
      <div class="team-grid">
        {teamMembers.map(member => (
          <TeamMember
            name={member.data.name}
            role={member.data.role}
            email={member.data.email}
            image={member.data.image}
            slug={member.slug}
          />
        ))}
      </div>
      <div class="alumni-link-container">
        <a href="/alumni" class="alumni-link">View our Alumni →</a>
      </div>
    </section>

    <section id="publications">
      <h2>Publication Highlights</h2>
      <p class="section-subtitle">Selected publications from our research group</p>
      <div class="publication-links">
        <a href="/phd-theses" class="pub-link-button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          View PhD Theses
        </a>
        <a href="https://scholar.google.com/citations?user=jCF3JncAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="pub-link-button scholar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
          </svg>
          Google Scholar Profile
        </a>
      </div> 
      {publications.map(pub => (
        <Publication
          title={pub.data.title}
          authors={pub.data.authors}
          venue={pub.data.venue}
          year={pub.data.year}
          volume={pub.data.volume}
          pages={pub.data.pages}
          article={pub.data.article}
          doi={pub.data.doi}
          pdf={pub.data.pdf}
          code={pub.data.code}
          dataset={pub.data.dataset}
          demo={pub.data.demo}
        />
      ))}
    </section>

    <section id="software">
      <h2>Software</h2>
      <p class="section-subtitle">Open-source tools and libraries developed by our group. We have made and continue to make contributions to well established electronic structure packages including <a href="https://fhi-aims.org/" target="_blank" rel="noopener noreferrer">FHI-aims</a>, <a href="https://www.castep.org/" target="_blank" rel="noopener noreferrer">CASTEP</a>, and <a href="https://www.dftbplus.org/" target="_blank" rel="noopener noreferrer">DFTB+</a>. Below is a list of in-house open-source packages we develop.</p>
      <div class="github-link-container">
        <a href="https://github.com/maurergroup" target="_blank" rel="noopener noreferrer" class="github-link-button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View GitHub Repository
        </a>
      </div>
      <div class="software-grid">
        {software.map(sw => (
          <SoftwareCard
            title={sw.data.title}
            description={sw.data.description}
            logo={sw.data.logo}
            github={sw.data.github}
            documentation={sw.data.documentation}
            language={sw.data.language}
            stars={sw.data.stars}
            slug={sw.slug}
          />
        ))}
      </div>
    </section>

    <section id="opportunities">
      <h2>Opportunities</h2>
      <p class="section-subtitle">Postdoc,  PhD, and MSc openings become available on a rolling basis. Informal inquiries via email are always welcome. Current openings:</p>
      <div class="opportunities-list">
        {opportunities.map(opp => (
          <OpportunityCard
            title={opp.data.title}
            type={opp.data.type}
            location={opp.data.location}
            deadline={opp.data.deadline}
            open={opp.data.open}
            slug={opp.slug}
          />
        ))}
      </div>
      {opportunities.length === 0 && (
        <p class="no-opportunities">No open positions at the moment. Please check back later or contact us about future opportunities.</p>
      )}
    </section>

    <section id="locations">
      <h2>How to Find Us</h2>
      <p class="section-subtitle">The group is located across three international locations</p>
      <div class="locations-grid">
        <div class="location-card" data-location="at">
          <div class="location-flag">🇦🇹</div>
          <h3>Vienna, Austria</h3>
          <div class="location-image">
            <img src="/images/vienna_location.jpg" alt="Vienna office" />
          </div>          
          <p class="location-address">
            Computational Materials Physics<br>
            Faculty of Physics<br>
            University of Vienna<br>
            Kolingasse 14-16<br>
            1090 Vienna, Austria
          </p>
          <div class="location-team">
            <strong>Team Members:</strong>
            <ul>
              {locations.at.map(member => (
                <li>{member.data.name}</li>
              ))}
            </ul>
          </div>
          <div class="location-contact">
            <p><strong>Web:</strong> <a href="https://cmp.univie.ac.at/">Webpage of U Vienna</a></p>
            <p><strong>Phone:</strong> +43-1-4277-733 23</p>
          </div>
        </div>

        <div class="location-card" data-location="uk">
          <div class="location-flag">🇬🇧</div>
          <h3>Coventry, UK</h3>
          <div class="location-image">
            <img src="/images/warwick_location.jpg" alt="Warwick office" />
          </div>          
          <p class="location-address">
            Centre for Computational and Theoretical Chemistry<br>
            Department of Chemistry<br>
            University of Warwick<br>
            Coventry CV4 7AL
          </p>
          <div class="location-team">
            <strong>Team Members:</strong>
            <ul>
              {locations.uk.map(member => (
                <li>{member.data.name}</li>
              ))}
            </ul>
          </div>
          <div class="location-contact">
            <p><strong>Web:</strong> <a href="https://warwick.ac.uk/fac/sci/chemistry/staff/reinhardmaurer/">Webpage of U Warwick</a></p>
          </div>
        </div>

        <div class="location-card" data-location="de">
          <div class="location-flag">🇩🇪</div>
          <h3>Göttingen, Germany</h3>
          <div class="location-image">
            <img src="/images/goettingen_location.jpg" alt="Göttingen office" />
          </div>          
          <p class="location-address">
            Chair of Theoretical Chemistry<br>
            Institut für Physikalische Chemie<br>
            Tammannstraße 6<br>
            University of Göttingen<br>
            37077 Göttingen, Germany <br>
            and Max-Planck-Institute for Multidisciplinary Sciences
          </p>
          <div class="location-team">
            <strong>Team Members:</strong>
            <ul>
              {locations.de.map(member => (
                <li>{member.data.name}</li>
              ))}
            </ul>
          </div>
          <div class="location-contact">
            <p><strong>Web:</strong> <a href="https://www.uni-goettingen.de/de/forschung/503294.html">Webpage of U Göttingen</a></p>
            <p><strong>Phone:</strong> +49(551) 39-23133</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer>
    <div class="footer-content">
      <p>&copy; 2025 Computational Surface Science Group. All rights reserved.</p>
      <a href="https://www.linkedin.com/in/reinhard-maurer-357803aa/" target="_blank" rel="noopener noreferrer" class="footer-linkedin" aria-label="LinkedIn Profile">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>
  </footer>
</Layout>

<style>
  .research-overview {
    background: var(--bg-alt);
    padding: 2rem;
    border-radius: 12px;
    border-left: 4px solid var(--primary);
    margin-bottom: 3rem;
  }

  .research-overview p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-light);
    margin: 0;
  }

  .section-subheading {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: var(--primary);
    font-weight: 600;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    align-items: start;
  }

  .profile-image {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 4rem;
    font-weight: 700;
    overflow: hidden;
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio h3 {
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }

  .bio-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-light);
    margin-top: 1rem;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
  }

  .alumni-link-container {
    margin-top: 3rem;
    text-align: center;
  }

  .alumni-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background: var(--primary);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.125rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .alumni-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(102, 126, 234, 0.3);
  }

  .alumni-link:active {
    transform: translateY(0);
  }

  .publication-links {
    margin: 2rem 0;
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pub-link-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: var(--bg-alt);
    color: var(--primary);
    text-decoration: none;
    border: 2px solid var(--primary);
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .pub-link-button:hover {
    background: var(--primary);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
  }

  .pub-link-button:active {
    transform: translateY(0);
  }

  .pub-link-button.scholar {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }

  .pub-link-button.scholar:hover {
    background: #4285f4;
    border-color: #4285f4;
  }

  .software-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .opportunities-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .no-opportunities {
    text-align: center;
    color: var(--text-light);
    padding: 3rem;
    background: var(--bg-alt);
    border-radius: 12px;
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .location-card {
    background: var(--bg-alt);
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid var(--border);
    transition: all 0.3s;
    cursor: pointer;
  }

  .location-card:hover {
    border-color: var(--primary);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .location-image {
    width: 100%;
    height: 200px;
    margin: -1rem -1rem 1rem -1rem;
    border-radius: 10px 10px 0 0;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .location-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.125rem;
    opacity: 0.8;
  }

  .location-flag {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .location-card h3 {
    color: var(--primary);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .location-address {
    color: var(--text-light);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .location-team {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--bg);
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .location-team strong {
    color: var(--text);
    display: block;
    margin-bottom: 0.5rem;
  }

  .location-team ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .location-team li {
    color: var(--text-light);
    padding: 0.25rem 0;
    font-size: 0.9rem;
  }

  .location-contact {
    color: var(--text-light);
    font-size: 0.9rem;
  }

  .location-contact p {
    margin: 0.5rem 0;
  }

  .location-contact strong {
    color: var(--text);
  }

  footer {
    background: var(--bg-alt);
    color: var(--text-light);
    padding: 3rem 2rem;
    text-align: center;
    border-top: 1px solid var(--border);
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  footer p {
    opacity: 0.8;
    margin: 0;
  }

  .footer-linkedin {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--text-light);
    background: var(--bg);
    border-radius: 8px;
    transition: background-color 0.3s, color 0.3s, transform 0.2s;
    text-decoration: none;
  }

  .footer-linkedin:hover {
    background: #0077b5;
    color: white;
    transform: scale(1.05);
  }

  .footer-linkedin:active {
    transform: scale(0.95);
  }

  @media (max-width: 768px) {
    .research-overview p {
      font-size: 1rem;
    }

    .about-content {
      grid-template-columns: 1fr;
    }

    .software-grid {
      grid-template-columns: 1fr;
    }

    .locations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href')!);
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>
