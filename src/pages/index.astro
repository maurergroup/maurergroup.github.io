---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import TeamMember from '../components/TeamMember.astro';
import Publication from '../components/Publication.astro';
import ResearchCard from '../components/ResearchCard.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import OpportunityCard from '../components/OpportunityCard.astro';
import { getCollection } from 'astro:content';

const teamMembers = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const publications = (await getCollection('publications')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const researchAreas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const software = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order);
const opportunities = (await getCollection('opportunities')).filter(opp => opp.data.open).sort((a, b) => a.data.order - b.data.order);

const principalInvestigator = teamMembers[0];

// Group team members by location (members can appear in multiple locations)
const locations = {
  at: teamMembers.filter(m => m.data.locations?.includes('at')),
  uk: teamMembers.filter(m => m.data.locations?.includes('uk')),
  de: teamMembers.filter(m => m.data.locations?.includes('de'))
};
---

<Layout title="Computational Surface Science"></Layout>
  <Navigation />
  <Hero 
    title="The Maurer Computational Surface Science Group"
    subtitle="Exploring the intersection of computational simulation and surface science to drive innovation in materials and chemical processes."
  />

  <div class="container">
    <section id="about">
      <h2>Machine-learning-enabled Chemical Dynamics at Interfaces</h2>
      <div class="research-overview">
       <p><b>Our Research Vision</b> is to develop and apply new simulation methods and prediction tools that fuse machine learning (ML) and data-driven approaches with quantum mechanical (QM) electronic structure and dynamical simulation methods. Doing so will remove existing bottlenecks in simulation capabilities that limit the length and time scales and the complexity of chemical simulations. More importantly, hybrid ML/QM methods enable fundamentally new prediction approaches that defy the conventional structure-to-property paradigm that underpins modern chemical studies. The Maurer group applies newly developed ML-enabled research tools in the areas of high-throughput molecular design for organic electronics and functional interfaces, as well as the study of chemical dynamics triggered by extremely short or intense light and electromagnetic fields.</p>
      </div>
      <h3 class="section-subheading">Head of the Group</h3>
      <div class="about-content">
        <div class="profile-image">
          {principalInvestigator.data.image ? (
            <img src={principalInvestigator.data.image} alt={principalInvestigator.data.name} />
          ) : (
            principalInvestigator.data.name.split(' ').map(n => n[0]).join('')
          )}
        </div>
        <div class="bio">
          <h3>{principalInvestigator.data.name}</h3>
          <p><strong>{principalInvestigator.data.role}</strong></p>
          <div class="bio-text">
            <p>
              Prof. Dr. Reinhard J. Maurer leads the Computational Surface Science Group, focusing on theoretical and computational methods to understand the chemistry and physics of surfaces and interfaces. He is a Professor of Computational Chemistry at the University of Warwick (UK), Professor of Computational Materials Discovery at the University of Vienna (Austria), and will be soon be joining the University of Göttingen (Germany) as the Alexander-von-Humboldt Professor of Theoretical Chemistry.
            </p>
            <p>
              His research combines electronic structure theory, molecular and quantum dynamics, and machine learning methods to study quantum phenomena at surfaces with applications in photocatalysis, nanotechnology, and electrochemistry.
            </p>
            <p><a href="/team/reinhard-maurer">Read full profile →</a></p>
          </div>
        </div>
      </div>
    </section>

    <section id="research">
      <h2>Research Areas</h2>
      <p class="section-subtitle">Our lab focuses on several cutting-edge areas of computational material science and chemistry</p>
      <div class="research-grid">
        {researchAreas.map(area => (
          <ResearchCard
            title={area.data.title}
            description={area.data.description}
            slug={area.slug}
          />
        ))}
      </div>
    </section>

    <section id="team">
      <h2>Our Team</h2>
      <p class="section-subtitle">Meet the brilliant minds behind our research</p>
      <div class="team-grid">
        {teamMembers.map(member => (
          <TeamMember
            name={member.data.name}
            role={member.data.role}
            email={member.data.email}
            image={member.data.image}
            slug={member.slug}
          />
        ))}
      </div>
    </section>

    <section id="publications">
      <h2>Recent Publications</h2>
      <p class="section-subtitle">Selected publications from our research group. You'll find a full list on <a href="https://scholar.google.com/citations?user=jCF3JncAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>.</p>
      {publications.map(pub => (
        <Publication
          title={pub.data.title}
          authors={pub.data.authors}
          venue={pub.data.venue}
          year={pub.data.year}
          volume={pub.data.volume}
          pages={pub.data.pages}
          article={pub.data.article}
          doi={pub.data.doi}
          pdf={pub.data.pdf}
          code={pub.data.code}
          dataset={pub.data.dataset}
          demo={pub.data.demo}
        />
      ))}
    </section>

    <section id="software">
      <h2>Software</h2>
      <p class="section-subtitle">Open-source tools and libraries developed by our group</p>
      <div class="software-grid">
        {software.map(sw => (
          <SoftwareCard
            title={sw.data.title}
            description={sw.data.description}
            github={sw.data.github}
            documentation={sw.data.documentation}
            language={sw.data.language}
            stars={sw.data.stars}
          />
        ))}
      </div>
    </section>

    <section id="opportunities">
      <h2>Opportunities</h2>
      <p class="section-subtitle">Join our team - current openings</p>
      <div class="opportunities-list">
        {opportunities.map(opp => (
          <OpportunityCard
            title={opp.data.title}
            type={opp.data.type}
            location={opp.data.location}
            deadline={opp.data.deadline}
            open={opp.data.open}
            slug={opp.slug}
          />
        ))}
      </div>
      {opportunities.length === 0 && (
        <p class="no-opportunities">No open positions at the moment. Please check back later or contact us about future opportunities.</p>
      )}
    </section>

    <section id="locations">
      <h2>How to Find Us</h2>
      <p class="section-subtitle">The group is located across three international locations</p>
      <div class="locations-grid">
        <div class="location-card" data-location="at">
          <div class="location-flag">🇦🇹</div>
          <h3>Vienna, Austria</h3>
          <div class="location-image">
            <img src="/src/images/vienna_location.jpg" alt="Vienna office" />
          </div>          
          <p class="location-address">
            Computational Materials Physics<br>
            Faculty of Physics<br>
            University of Vienna<br>
            Kolingasse 14-16<br>
            1090 Vienna, Austria
          </p>
          <div class="location-team">
            <strong>Team Members:</strong>
            <ul>
              {locations.at.map(member => (
                <li>{member.data.name}</li>
              ))}
            </ul>
          </div>
          <div class="location-contact">
            <p><strong>Web:</strong> <a href="https://cmp.univie.ac.at/">Webpage of U Vienna</a></p>
            <p><strong>Phone:</strong> +43-1-4277-733 23</p>
          </div>
        </div>

        <div class="location-card" data-location="uk">
          <div class="location-flag">🇬🇧</div>
          <h3>Coventry, UK</h3>
          <div class="location-image">
            <img src="/src/images/warwick_location.jpg" alt="Warwick office" />
          </div>          
          <p class="location-address">
            Centre for Computational and Theoretical Chemistry<br>
            Department of Chemistry<br>
            University of Warwick<br>
            Coventry CV4 7AL
          </p>
          <div class="location-team">
            <strong>Team Members:</strong>
            <ul>
              {locations.uk.map(member => (
                <li>{member.data.name}</li>
              ))}
            </ul>
          </div>
          <div class="location-contact">
            <p><strong>Web:</strong> <a href="https://warwick.ac.uk/fac/sci/chemistry/research/catch/">Webpage of U Warwick</a></p>
            <p><strong>Phone:</strong> +44 (0)2476 5 23228</p>
          </div>
        </div>

        <div class="location-card" data-location="de">
          <div class="location-flag">🇩🇪</div>
          <h3>Göttingen, Germany</h3>
          <div class="location-image">
            <img src="/src/images/goettingen_location.jpg" alt="Göttingen office" />
          </div>          
          <p class="location-address">
            Coming Soon! (starting in March 2026)<br>
            Chair of Theoretical Chemistry<br>
            Institut für Physikalische Chemie<br>
            Tammannstraße 6<br>
            University of Göttingen<br>
            37077 Göttingen, Germany
          </p>
          <div class="location-team">
            <strong>Team Members:</strong>
            <ul>
              {locations.de.map(member => (
                <li>{member.data.name}</li>
              ))}
            </ul>
          </div>
          <div class="location-contact">
            <p><strong>Web:</strong> <a href="https://www.uni-goettingen.de/de/28451.html">Webpage of U Göttingen</a></p>
            <p><strong>Phone:</strong> +49(551) 39-23102</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer>
    <p>&copy; 2025 Computational Surface Science Group. All rights reserved.</p>
  </footer>
</Layout>

<style>
  .research-overview {
    background: var(--bg-alt);
    padding: 2rem;
    border-radius: 12px;
    border-left: 4px solid var(--primary);
    margin-bottom: 3rem;
  }

  .research-overview p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-light);
    margin: 0;
  }

  .section-subheading {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: var(--primary);
    font-weight: 600;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 3rem;
    align-items: start;
  }

  .profile-image {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 4rem;
    font-weight: 700;
    overflow: hidden;
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio h3 {
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }

  .bio-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-light);
    margin-top: 1rem;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
  }

  .software-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .opportunities-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .no-opportunities {
    text-align: center;
    color: var(--text-light);
    padding: 3rem;
    background: var(--bg-alt);
    border-radius: 12px;
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .location-card {
    background: var(--bg-alt);
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid var(--border);
    transition: all 0.3s;
    cursor: pointer;
  }

  .location-card:hover {
    border-color: var(--primary);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .location-image {
    width: 100%;
    height: 200px;
    margin: -1rem -1rem 1rem -1rem;
    border-radius: 10px 10px 0 0;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .location-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.125rem;
    opacity: 0.8;
  }

  .location-flag {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .location-card h3 {
    color: var(--primary);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .location-address {
    color: var(--text-light);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .location-team {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: white;
    border-radius: 8px;
  }

  .location-team strong {
    color: var(--text);
    display: block;
    margin-bottom: 0.5rem;
  }

  .location-team ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .location-team li {
    color: var(--text-light);
    padding: 0.25rem 0;
    font-size: 0.9rem;
  }

  .location-contact {
    color: var(--text-light);
    font-size: 0.9rem;
  }

  .location-contact p {
    margin: 0.5rem 0;
  }

  .location-contact strong {
    color: var(--text);
  }

  footer {
    background: var(--text);
    color: white;
    padding: 3rem 2rem;
    text-align: center;
  }

  footer p {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .research-overview p {
      font-size: 1rem;
    }

    .about-content {
      grid-template-columns: 1fr;
    }

    .software-grid {
      grid-template-columns: 1fr;
    }

    .locations-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href')!);
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>