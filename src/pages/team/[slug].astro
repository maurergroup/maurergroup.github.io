---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const teamMembers = await getCollection('team');
  return teamMembers.map(member => ({
    params: { slug: member.slug },
    props: { member }
  }));
}) satisfies GetStaticPaths;

const { member } = Astro.props;
const { Content } = await member.render();
const initials = member.data.name.split(' ').map(n => n[0]).join('');
---

<Layout title={`${member.data.name} - Research Lab`}>
  <Navigation />

  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href="/#team">Team</a> / {member.data.name}
    </div>

    <div class="profile-header">
      <div class="profile-photo">
        {member.data.image ?
          <img src={member.data.image} alt={member.data.name} /> :
          initials
        }
      </div>
      <div class="profile-info">
        <h1>{member.data.name}</h1>
        <p class="role">{member.data.role}</p>
        <div class="contact-links">
          <a href={`mailto:${member.data.email}`} class="contact-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            Email
          </a>
          {member.data.website && (
            <a href={member.data.website} target="_blank" class="contact-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              Website
            </a>
          )}
          {member.data.scholar && (
            <a href={member.data.scholar} target="_blank" class="contact-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
              </svg>
              Scholar
            </a>
          )}
          {member.data.github && (
            <a href={`https://github.com/${member.data.github}`} target="_blank" class="contact-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
          )}
          {member.data.twitter && (
            <a href={`https://twitter.com/${member.data.twitter}`} target="_blank" class="contact-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>
              </svg>
              Twitter
            </a>
          )}
        </div>
      </div>
    </div>

    {member.data.researchInterests && member.data.researchInterests.length > 0 && (
      <div class="section">
        <h2>Research Interests</h2>
        <div class="interests-grid">
          {member.data.researchInterests.map(interest => (
            <div class="interest-tag">{interest}</div>
          ))}
        </div>
      </div>
    )}

    <div class="section">
      <h2>Biography</h2>
      <div class="content-wrapper">
        <Content />
      </div>
    </div>

    {member.data.education && member.data.education.length > 0 && (
      <div class="section">
        <h2>Education</h2>
        <div class="education-list">
          {member.data.education.map(edu => (
            <div class="education-item">
              <div class="education-degree">{edu.degree}</div>
              <div class="education-institution">{edu.institution}</div>
              <div class="education-year">{edu.year}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="back-link">
      <a href="/#team">← Back to Team</a>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .breadcrumb {
    margin-bottom: 2rem;
    color: var(--text-light);
    font-size: 0.875rem;
  }

  .breadcrumb a {
    color: var(--primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .profile-header {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
    align-items: start;
  }

  .profile-photo {
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 4rem;
    font-weight: 700;
    overflow: hidden;
  }

  .profile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-info h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .role {
    font-size: 1.25rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    transition: all 0.3s;
    font-size: 0.9rem;
  }

  .contact-link:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .section {
    margin-bottom: 3rem;
  }

  .section h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    color: var(--text);
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .interests-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .interest-tag {
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .content-wrapper {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-light);
  }

  .content-wrapper :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text);
    border-bottom: none;
  }

  .content-wrapper :global(h3) {
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .content-wrapper :global(p) {
    margin-bottom: 1rem;
  }

  .content-wrapper :global(ul) {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .education-item {
    padding: 1.5rem;
    background: var(--bg-alt);
    border-left: 4px solid var(--primary);
    border-radius: 8px;
  }

  .education-degree {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .education-institution {
    color: var(--text-light);
    margin-bottom: 0.25rem;
  }

  .education-year {
    color: var(--text-light);
    font-size: 0.9rem;
  }

  .back-link {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .back-link a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.3s;
  }

  .back-link a:hover {
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .profile-header {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }

    .profile-photo {
      width: 150px;
      height: 150px;
      font-size: 3rem;
    }

    .profile-info h1 {
      font-size: 2rem;
    }

    .contact-links {
      justify-content: center;
    }
  }
</style>
